# Variabili aggiuntive per Airflow. Aggiungi queste righe al tuo .env
# (accanto a quelle già generate da env.example) prima di avviare l'overlay
# docker-compose.airflow.yml.

# Metadata DB dedicato di Airflow (NON il postgres applicativo)
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=changeme
AIRFLOW_DB_NAME=airflow

# Utente admin della UI (http://localhost:8090)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changeme
AIRFLOW_ADMIN_EMAIL=admin@admin.com

# Chiave usata da Airflow per cifrare le connection/variable salvate nel
# metadata DB. Generala una volta con:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# e riusa sempre la stessa (rigenerarla rende illeggibili le connessioni salvate).
AIRFLOW_FERNET_KEY=
